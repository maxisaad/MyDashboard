VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Strava Client ID (public, safe to expose in frontend)
VITE_STRAVA_CLIENT_ID=your-strava-client-id

# ⚠️ Strava Client Secret — NEVER put this in a VITE_ variable.
# Set it as a server-side secret in your Supabase Edge Function environment:
#   supabase secrets set STRAVA_CLIENT_SECRET=your-strava-client-secret
